{#- Shared fragments — SPEC.md §12. -#}

{%- macro verse(unit) -%}
<div class="verse" id="{{ unit.verse_id }}">
          <span class="verse-number">{{ unit.verse_label }}</span>
          <span class="biblical-text">{{ unit.verse_html }}</span>
        </div>
{%- endmacro -%}

{%- macro commentary_entry(entry, slug) -%}
<div class="commentary-entry {{ slug }}" id="{{ entry.id }}">
        {%- for paragraph in entry.paragraphs %}
        <p class="commentary-text">{% if loop.first and entry.dibur_hamatchil %}<span class="dibur-hamatchil">{{ entry.dibur_hamatchil }}</span> {% endif %}{{ paragraph }}</p>
        {%- endfor %}
      </div>
{%- endmacro -%}
