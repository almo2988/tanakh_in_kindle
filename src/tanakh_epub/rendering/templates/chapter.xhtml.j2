{#-
  One chapter — SPEC.md §11, §12, §17, §18.

  Two layouts, chosen by `commentary.mode`:

  * `blocks` — a run of consecutive verses, then the Rashi on that whole run, after the
    manner of a printed מקראות גדולות page. Each region is one continuous stream: verses
    are inline spans inside a single paragraph rather than a container apiece, and so are
    the commentary entries, so neither region is broken up by the structure of the other.
    The canonical association is carried by ids and `data-ref` on every verse and every
    entry — it lives in the data, not in the visual grouping.

  * `interleaved` — each verse immediately followed by its own Rashi, with the small
    `keep-together` block (verse + divider + first entry) carrying the page-break hint.
    This is the Phase 1 layout and what SPEC §2 as written requires.

  The verse and each commentary entry arrive as internal markup that markup.py has already
  escaped; every other value is autoescaped by Jinja.
-#}
{%- import "_macros.xhtml.j2" as m -%}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops"
      xml:lang="he" lang="he" dir="rtl">
<head>
  <meta charset="utf-8"/>
  <title>{{ page_title }}</title>
  <link rel="stylesheet" type="text/css" href="../styles/main.css"/>
</head>
<body dir="rtl">
  <section id="{{ chapter_anchor }}" epub:type="chapter"{% if book_start %} class="book-start"{% endif %}>
{%- if book_start %}
    <h1 class="book-heading">{{ book_hebrew_title }}</h1>
{%- endif %}
    <h2 class="chapter-heading">{{ chapter_label }}</h2>
{%- if mode == "blocks" %}
{%- for block in blocks %}
    <section class="study-block" id="{{ block.id }}">
      <div class="tanakh">
        <p class="biblical-flow">
          {%- for unit in block.verses %}
          {{ m.verse_run(unit) }}
          {%- endfor %}
        </p>
      </div>
      {%- if block.commentary %}
      <div class="commentary-divider {{ block.commentary.slug }}-divider">{{ block.commentary.hebrew }}</div>
      <div class="commentary {{ block.commentary.slug }}">
        <p class="commentary-flow">
          {%- for entry in block.commentary.entries %}
          {{ m.commentary_run(entry, block.commentary.slug) }}
          {%- endfor %}
        </p>
      </div>
      {%- endif %}
    </section>
{%- endfor %}
{%- else %}
{%- for unit in units %}
    <section class="study-unit">
      <div class="keep-together">
        {{ m.verse_block(unit) }}
        {%- if unit.commentary %}
        <div class="commentary-divider {{ unit.commentary.slug }}-divider">{{ unit.commentary.hebrew }}</div>
        {{ m.commentary_block(unit.commentary.entries[0], unit.commentary.slug) }}
        {%- endif %}
      </div>
      {%- if unit.commentary and unit.commentary.entries|length > 1 %}
      <section class="commentary {{ unit.commentary.slug }}">
        {%- for entry in unit.commentary.entries[1:] %}
        {{ m.commentary_block(entry, unit.commentary.slug) }}
        {%- endfor %}
      </section>
      {%- endif %}
    </section>
{%- endfor %}
{%- endif %}
  </section>
</body>
</html>
