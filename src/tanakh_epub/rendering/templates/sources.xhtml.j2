{#- מקורות — SPEC_DATA_SOURCE.md §13. Hebrew only, like every other reading page.
    Version titles and licenses are technical identifiers and stay in their original
    spelling; naming them exactly is what the licenses require. -#}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops"
      xml:lang="he" lang="he" dir="rtl">
<head>
  <meta charset="utf-8"/>
  <title>{{ heading }}</title>
  <link rel="stylesheet" type="text/css" href="../styles/main.css"/>
</head>
<body dir="rtl">
  <section id="sources" epub:type="copyright-page" class="sources">
    <h1 class="book-heading">{{ heading }}</h1>
    <p class="sources-lead">הטקסטים בפרסום זה מבוססים על נתונים שהתקבלו מספריא (Sefaria).
       גרסאות הטקסט והרישיונות מפורטים להלן.</p>

    <h2 class="chapter-heading">{{ text_heading }}</h2>
{%- for source in text_sources %}
    <div class="source-entry">
      <p class="source-label">{{ source.label }}</p>
      <p class="source-detail" dir="ltr" lang="en" xml:lang="en">{{ source.version_title }}</p>
      <p class="source-detail">רישיון: <span dir="ltr" lang="en" xml:lang="en">{{ source.license }}</span></p>
{%- if source.books %}
      <p class="source-detail">ספרים: {{ source.books }}</p>
{%- endif %}
    </div>
{%- endfor %}

    <h2 class="chapter-heading">{{ fonts_heading }}</h2>
{%- for font in fonts %}
    <div class="source-entry">
      <p class="source-label">{{ font.label }}</p>
      <p class="source-detail" dir="ltr" lang="en" xml:lang="en">{{ font.name }}</p>
      <p class="source-detail">רישיון: <span dir="ltr" lang="en" xml:lang="en">{{ font.license }}</span></p>
    </div>
{%- endfor %}

    <h2 class="chapter-heading">{{ build_heading }}</h2>
    <div class="source-entry">
      <p class="source-detail">תאריך הפקה: {{ build_date_hebrew }}</p>
    </div>
  </section>
</body>
</html>
