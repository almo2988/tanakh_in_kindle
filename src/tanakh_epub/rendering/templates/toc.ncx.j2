{#- EPUB 2 NCX — SPEC.md §4, §10. Kept alongside nav.xhtml because Kindle conversion
    tools and older readers still lean on it. Same two levels, same anchors. -#}
<?xml version="1.0" encoding="utf-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1" xml:lang="he" dir="rtl">
  <head>
    <meta name="dtb:uid" content="{{ identifier }}"/>
    <meta name="dtb:depth" content="{{ depth }}"/>
    <meta name="dtb:totalPageCount" content="0"/>
    <meta name="dtb:maxPageNumber" content="0"/>
  </head>
  <docTitle><text>{{ title }}</text></docTitle>
  <navMap>
{%- for point in nav_points %}
    <navPoint id="{{ point.id }}" playOrder="{{ point.play_order }}">
      <navLabel><text>{{ point.title }}</text></navLabel>
      <content src="{{ point.href }}"/>
{%- for child in point.children %}
      <navPoint id="{{ child.id }}" playOrder="{{ child.play_order }}">
        <navLabel><text>{{ child.title }}</text></navLabel>
        <content src="{{ child.href }}"/>
      </navPoint>
{%- endfor %}
    </navPoint>
{%- endfor %}
  </navMap>
</ncx>
